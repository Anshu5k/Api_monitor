# Environment
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27018/
MONGO_DB_NAME=api-monitoring

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=mypassword

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/api_monitoring
RABBITMQ_QUEUE=api-hits
RABBITMQ_PUBLISHER_CONFIRM=false
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY=5000

# JWT
JWT_SECRET=12345671712
JWT_EXPIRES_IN=3d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000